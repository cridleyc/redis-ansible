---
  ubuntu_nodes:
    hosts:
      vm1:
        ansible_host: "$(multipass info vm1 | awk '/IPv4/ {print $2}')"
        ansible_user: "ubuntu"
        ansible_ssh_private_key_file: "~/.ssh/multipass_ansible"
        ansible_remote_tmp: "/tmp/.ansible-ubuntu/tmp"
        ansible_become: true
        ansible_become_method: sudo

      vm2:
        ansible_host: "$(multipass info vm2 | awk '/IPv4/ {print $2}')"
        ansible_user: "ubuntu"
        ansible_ssh_private_key_file: "~/.ssh/multipass_ansible"
        ansible_remote_tmp: "/tmp/.ansible-ubuntu/tmp"
        ansible_become: true
        ansible_become_method: sudo

      vm3:
        ansible_host: "$(multipass info vm3 | awk '/IPv4/ {print $2}')"
        ansible_user: "ubuntu"
        ansible_ssh_private_key_file: "~/.ssh/multipass_ansible"
        ansible_remote_tmp: "/tmp/.ansible-ubuntu/tmp"
        ansible_become: true
        ansible_become_method: sudo